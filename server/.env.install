# ParkON 무인 설치 환경 설정
# 이 파일을 수정하고 --non-interactive 옵션으로 install.sh를 실행하세요.

# JWT 서명 시크릿 (반드시 변경)
JWT_SECRET=change-this-to-a-random-32-byte-string

# 서비스 도메인
SERVER_DOMAIN=parkon.example.com

# SMTP 설정 (메일 발송 기능)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=parkon@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=parkon@example.com
